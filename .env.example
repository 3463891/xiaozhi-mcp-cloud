# ---- 小智 MCP 接入点（可选，填了会在启动时自动创建并连接一个默认实例）----
# 获取：xiaozhi.me 控制台 → 智能体 → 配置角色 → 扩展能力 → MCP 接入点 → 复制
# MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=xxxxxxxx
# MCP_SERVICES=cloud-search,finance,life,utils

# ---- 管理员账号（可选，建议设置，容器重启后账号不会丢）----
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# ---- 站点配置 ----
# 会话签名密钥，建议 32 位随机串；不填会自动生成
# SECRET_KEY=
# 是否开放自助注册（false 则只有管理员账号能登录）
# ALLOW_PUBLIC_REGISTER=true

# ---- 保活（防止免费云平台休眠）----
# 自己的公网地址，不填则尝试从 SPACE_HOST / RENDER_EXTERNAL_URL 推导
# SELF_URL=https://your-space.hf.space
# KEEPALIVE_INTERVAL=180

# ---- 搜索增强（可选，留空则用免密钥引擎 Bing/DuckDuckGo/搜狗）----
# TAVILY_API_KEY=
# BOCHA_API_KEY=

# ---- 其他 ----
# PORT=7860
# LOG_LEVEL=INFO
# TOOL_TIMEOUT=25
# HTTP_TIMEOUT=8
